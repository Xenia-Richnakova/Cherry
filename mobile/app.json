{
  "expo": {
    "name": "Cherry",
    "slug": "cherry",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Cherry_logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/Cherry_logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./src/features/bank-notifications/withBankNotificationListener",
      "expo-sharing",
      "expo-secure-store"
    ]
  }
}
